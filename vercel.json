{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/souq-capital run build",
  "outputDirectory": "artifacts/souq-capital/dist/public",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/documents.ts": {
      "maxDuration": 300
    },
    "api/intake.ts": {
      "maxDuration": 300
    }
  }
}
